MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/derma-tracker
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode (prefix rzp_test_ = test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Server & Client Configuration
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Public URL for mobile phones scanning QR on cellular data (e.g. ngrok / Cloudflare Tunnel / Production Domain)
PUBLIC_APP_URL=

# ── OTP Delivery: Android SMS Gateway (capcom6/android-sms-gateway) ──
# Option A: Cloud Server mode (RECOMMENDED for deployed apps — works anywhere)
# In app: Enable "Cloud server" toggle
SMS_GATEWAY_URL=https://api.sms-gate.app
SMS_GATEWAY_USERNAME=your_cloud_username
SMS_GATEWAY_PASSWORD=your_cloud_password
SMS_GATEWAY_DEVICE_ID=your_device_id_optional

# Option B: Local Server mode (Local dev only — phone & server on same Wi-Fi)
# SMS_GATEWAY_URL=http://192.168.1.100:8080
# SMS_GATEWAY_USERNAME=your_local_username
# SMS_GATEWAY_PASSWORD=your_local_password

# ── OTP Delivery: WhatsApp via Baileys (set to true after scanning QR) ──
WHATSAPP_ENABLED=false

# ── OTP Testing: set to true to always use OTP=123456 (easy dev testing) ──
HARDCODE_DEV_OTP=false

# ── Image Storage: Local Disk vs Cloudinary ──
# Set LOCALSTORAGE_ENABLED=true to store all uploaded images locally on server disk
LOCALSTORAGE_ENABLED=false

# Cloudinary (Free Tier — No Card Required)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ENABLED=false
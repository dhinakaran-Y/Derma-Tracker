MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/derma-tracker
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode (prefix rzp_test_ = test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Server & Client Configuration
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Public URL for mobile phones scanning QR on cellular data (e.g. ngrok / Cloudflare Tunnel / Production Domain)
PUBLIC_APP_URL=

# ── OTP Delivery: Android SMS Gateway (capcom6/android-sms-gateway) ──
# Phone & server must be on the SAME Wi-Fi network
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_USERNAME=your_sms_gateway_username
SMS_GATEWAY_PASSWORD=your_sms_gateway_password

# ── OTP Delivery: WhatsApp via Baileys (set to true after scanning QR) ──
WHATSAPP_ENABLED=false

# ── OTP Testing: set to true to always use OTP=123456 (easy dev testing) ──
HARDCODE_DEV_OTP=false

# ── Image Storage: Local Disk vs Cloudinary ──
# Set LOCALSTORAGE_ENABLED=true to store all uploaded images locally on server disk
LOCALSTORAGE_ENABLED=false

# Cloudinary (Free Tier — No Card Required)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ENABLED=false
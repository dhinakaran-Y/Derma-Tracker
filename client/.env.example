# ── DermaTrack Frontend — Environment Variables Template ─────────────────────
# Copy this file to .env.local for local development.
# For production (Vercel), set these in the Vercel Dashboard → Project → Settings → Environment Variables.
#
# DO NOT add real values here. This file IS committed to git.

# ── Backend Server URL ─────────────────────────────────────────────────────────
# The root URL of your Express backend (no trailing slash, no /api suffix).
# Used by Next.js rewrites to proxy /api/* requests to the backend.
#
# Local:       http://localhost:5000
# Production:  https://derma-tracker.onrender.com
NEXT_PUBLIC_SERVER_URL=

# ── Full API Base URL ─────────────────────────────────────────────────────────
# The full URL pointing directly to the API root.
# The code auto-appends /api if missing, but it's clearer to include it.
#
# Local:       http://localhost:5000/api
# Production:  https://derma-tracker.onrender.com/api
NEXT_PUBLIC_API_URL=
